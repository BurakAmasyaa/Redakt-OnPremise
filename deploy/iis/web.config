<?xml version="1.0" encoding="UTF-8"?>
<!--
  Redakt On-Premise . IIS ters proxy + HTTPS + erisim kontrolu sablonu.

  Ne yapar:
    1. TLS'i IIS'te sonlandirir, HTTP isteklerini HTTPS'e kalici yonlendirir.
    2. Kalan tum istekleri yerel Node servisine iletir (http://127.0.0.1:8080).
    3. Windows'ta dogrulanan kullaniciyi X-Remote-User basligina yazar; servis
       AUTH_MODE=proxy ile bu basliga guvenir.

  Kurulum: bu dosya site kokune (ornegin C:\inetpub\wwwroot\Redakt), yanindaki
  App_Code klasoru de ayni yere kopyalanir. Site duzeyinde Windows
  Authentication ACIK, Anonymous Authentication KAPALI olmalidir.
  Gereksinimler: URL Rewrite 2.1, ARR 3.0 (proxy enabled), app pool CLR v4.0
  Integrated. Ayrinti icin KURULUM.md.

  NOT: XML yorumunda ardisik tire kullanmayin; IIS dosyayi gecersiz sayip 500 verir.
-->
<configuration>
  <system.webServer>

    <!-- Windows kullanicisini kimlik dogrulama SONRASI X-Remote-User'a yazar.
         URL Rewrite'in {LOGON_USER} degiskeni BeginRequest'te bos geldigi icin
         serverVariables ile yazilamiyor; bkz. App_Code\HeaderInjectorModule.cs -->
    <modules>
      <add name="HeaderInjectorModule" type="HeaderInjectorModule" preCondition="" />
    </modules>

    <rewrite>
      <!-- ARR ters proxy icin gereken server variable izinleri. Bu listeye
           HTTP_X_REMOTE_USER eklemeyin: applicationHost.config'de zaten global
           izinli olabilir ve mukerrer tanim 500.52 verir. Kimlik basligini
           zaten modul yaziyor.
           Kilit sunucu genelinde bir kez acilir:
           %windir%\system32\inetsrv\appcmd.exe unlock config -section:system.webServer/rewrite/allowedServerVariables -->
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_PROTO" />
        <add name="HTTP_X_FORWARDED_HOST" />
        <add name="HTTP_X_FORWARDED_FOR" />
      </allowedServerVariables>

      <rules>
        <!-- 1) HTTP'den HTTPS'e kalici yonlendirme -->
        <rule name="Redakt HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2) Ters proxy: kalan tum istekleri yerel Node servisine ilet.
             Node yalnizca 127.0.0.1 dinler; disaridan dogrudan erisilemez. -->
        <rule name="Redakt ReverseProxy to Node" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <security>
      <authentication>
        <windowsAuthentication>
          <providers>
            <!-- Negotiate/Kerberos yerine NTLM: ters proxy arkasindaki loopback
                 istekte Kerberos bilet dogrulamasi SPN'e takiliyor. Kimlik yine
                 etki alaninda dogrulanir. Kerberos calisan bir ortamda Negotiate
                 eklenebilir. -->
            <clear />
            <add value="NTLM" />
          </providers>
        </windowsAuthentication>
      </authentication>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
