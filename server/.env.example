# Bu dosyayı ".env" olarak kopyalayıp doldurun. .env asla commit edilmez.
# cp server/.env.example server/.env

# --- SQL Server bağlantısı ---
# ÖNEMLİ: Şifreleme açıkken IP adresi kullanılamaz (TLS, sunucu adının IP olmasına
# izin vermez). Buraya sunucunun DNS/host adını yazın.
SQL_HOST=plc-nb.local

# Named instance kullanılıyorsa SQL_INSTANCE, sabit port varsa SQL_PORT verin.
# İkisi birden verilemez. Sabit port kurumsal ortamda daha güvenilirdir:
# named instance portu dinamikse SQL servisi her yeniden başladığında değişir.
SQL_PORT=62538
#SQL_INSTANCE=SQL2025

SQL_DATABASE=Redakt
SQL_RULES_TABLE=dbo.RedaktKurallari

# --- Kimlik doğrulama ---
# sql     : SQL Server login (geliştirme)
# windows : Windows/NTLM kimlik doğrulaması (kurumsal kurulum için önerilir)
SQL_AUTH=sql
SQL_USER=redakt_reader
#SQL_DOMAIN=SIRKET

# Parola iki biçimden biriyle verilir.
#
# 1) SQL_PASSWORD_ENC — ÖNERİLEN (yalnızca Windows).
#    Windows DPAPI ile şifrelenmiş değerdir; yalnızca onu üreten hesap çözebilir.
#    Servisin çalışacağı hesapla oturum açıp şunu çalıştırın:
#        npm run encrypt-password
#    Çıkan satırı buraya yapıştırın ve SQL_PASSWORD satırını silin.
#SQL_PASSWORD_ENC=

# 2) SQL_PASSWORD — düz metin. Yalnızca geliştirme içindir.
#    Kurulumda kullanılırsa servis her açılışta log'a uyarı yazar.
SQL_PASSWORD=

# --- TLS ---
SQL_ENCRYPT=true
# Sunucuda kurum CA'sı imzalı sertifika yoksa true yapın.
SQL_TRUST_CERT=true

# --- HTTP servisi ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
STATIC_ROOT=../dist

# Kural listesi bellekte bu süre boyunca taze sayılır (ms).
RULES_CACHE_TTL_MS=60000

# --- Kayıt (log) ---
# Servisin tüm olayları buraya günlük dosyalar halinde yazılır.
# Belge içeriği ve bulunan isimler ASLA log'a yazılmaz.
LOG_DIR=../logs
# debug | info | warn | error
LOG_LEVEL=info
# Bu günden eski log dosyaları otomatik silinir.
LOG_RETENTION_DAYS=30
