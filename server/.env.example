# Bu dosyayı ".env" olarak kopyalayıp doldurun. .env asla commit edilmez.
# cp server/.env.example server/.env

# --- SQL Server bağlantısı ---
# ÖNEMLİ: Şifreleme açıkken IP adresi kullanılamaz (TLS, sunucu adının IP olmasına
# izin vermez). Buraya sunucunun DNS/host adını yazın.
SQL_HOST=sqlsrv.sirket.local

# Named instance kullanılıyorsa SQL_INSTANCE, sabit port varsa SQL_PORT verin.
# İkisi birden verilemez. Sabit port kurumsal ortamda daha güvenilirdir:
# named instance portu dinamikse SQL servisi her yeniden başladığında değişir.
SQL_PORT=62538
#SQL_INSTANCE=SQL2025

SQL_DATABASE=Redakt
SQL_RULES_TABLE=dbo.RedaktKurallari

# --- Kimlik doğrulama ---
# sql     : SQL Server login (geliştirme)
# windows : Windows/NTLM kimlik doğrulaması (kurumsal kurulum için önerilir)
SQL_AUTH=sql
SQL_USER=redakt_reader
#SQL_DOMAIN=SIRKET

# Parola iki biçimden biriyle verilir.
#
# 1) SQL_PASSWORD_ENC — ÖNERİLEN (yalnızca Windows).
#    Windows DPAPI ile şifrelenmiş değerdir; yalnızca onu üreten hesap çözebilir.
#    Servisin çalışacağı hesapla oturum açıp şunu çalıştırın:
#        npm run encrypt-password
#    Çıkan satırı buraya yapıştırın ve SQL_PASSWORD satırını silin.
#SQL_PASSWORD_ENC=

# 2) SQL_PASSWORD — düz metin. Yalnızca geliştirme içindir.
#    Kurulumda kullanılırsa servis her açılışta log'a uyarı yazar.
SQL_PASSWORD=

# --- TLS ---
SQL_ENCRYPT=true
# Sertifika doğrulaması. false = doğrula (önerilen).
# true yapmak şifrelemeyi korur ama sunucunun kim olduğunu doğrulamayı bırakır;
# araya giren bir makine kural listesini okuyabilir hâle gelir. Yalnızca kurum
# CA'sı imzalı sertifika kurulana kadar geçici olarak true yapın.
SQL_TRUST_CERT=false

# --- Kimlik doğrulama ---
# none  : kapalı. /api/rules TÜM kurumsal kural listesini kimliksiz döner.
#         O liste müşteri adları ve personel isimlerinden oluşur; yani listenin
#         kendisi korunması gereken bir varlıktır. Yalnızca geliştirme için.
# proxy : kimliği ters proxy (IIS / nginx) doğrular, servis onun ilettiği
#         başlığa güvenir.
AUTH_MODE=proxy

# Kimliği taşıyan başlık. IIS ARR ve nginx'te bu başlığı proxy ekler.
AUTH_USER_HEADER=x-remote-user

# İstek yalnızca bu adreslerden kabul edilir. Proxy aynı makinedeyse varsayılan
# yeterlidir. Ayrı makinedeyse proxy'nin IP'sini yazın. IPv4 için ağ maskesi
# yazılabilir (10.0.5.0/24). Liste boş bırakılamaz.
AUTH_TRUSTED_PROXIES=127.0.0.1,::1

# ÖNEMLİ: Proxy, istemciden gelen AUTH_USER_HEADER başlığını SİLMELİ.
# Silmezse herhangi bir kullanıcı isteğine o başlığı ekleyip başkası gibi
# görünür. Bu koşul serviste zorlanamaz, proxy yapılandırmasında sağlanır.

# --- HTTP servisi ---
# AUTH_MODE=proxy iken varsayılan 127.0.0.1'dir: kimlik kontrolü proxy'de
# yapıldığı için servisin dışarıdan doğrudan görünmemesi gerekir.
#HTTP_HOST=127.0.0.1
HTTP_PORT=8080
STATIC_ROOT=../dist

# --- HTTPS ---
# Sertifika verilirse servis doğrudan TLS ile dinler. Verilmezse düz HTTP kalır
# ve TLS'i ters proxy üstlenir — o durumda servis yalnızca 127.0.0.1'e bağlanmalı.
# Yollar server/ klasörüne görelidir.
#HTTPS_CERT=../config/redakt.crt
#HTTPS_KEY=../config/redakt.key
#HTTPS_CA=../config/kurum-ca.crt

# Kural listesi bellekte bu süre boyunca taze sayılır (ms).
RULES_CACHE_TTL_MS=60000

# --- Kayıt (log) ---
# Servisin tüm olayları buraya günlük dosyalar halinde yazılır.
# Belge içeriği ve bulunan isimler ASLA log'a yazılmaz.
LOG_DIR=../logs
# debug | info | warn | error
LOG_LEVEL=info
# Bu günden eski log dosyaları otomatik silinir.
LOG_RETENTION_DAYS=30
# Tek log dosyası bu boyutu aşarsa aynı gün içinde yeni parçaya geçilir.
LOG_MAX_FILE_MB=32
# Log klasörünün toplam boyutu; aşılırsa en eski dosyalar silinir.
# Hata döngüsünün diski doldurmasını engeller.
LOG_MAX_TOTAL_MB=512
